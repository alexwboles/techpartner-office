#!/bin/sh
# techpartner launcher. Inside a packaged TechPartner Office it runs the bundled CLI on the
# app's own Node runtime (ELECTRON_RUN_AS_NODE); in a dev checkout it falls
# back to the system node and the local build output. Usually reached through
# a symlink on the PATH, so the real location is resolved first.
self="$0"
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case "$target" in
    /*) self="$target" ;;
    *) self="$(dirname "$self")/$target" ;;
  esac
done
here=$(cd "$(dirname "$self")" && pwd)

if [ -n "${TECHPARTNER_NODE:-${GENOFFICE_NODE:-}}" ]; then
  exec "${TECHPARTNER_NODE:-$GENOFFICE_NODE}" "$here/techpartner.cjs" "$@"
fi

case "$here" in
  */Contents/Resources/cli) app="$here/../../MacOS/TechPartner Office" ;;
  */resources/cli)
    # Linux install, or the Windows install reached from Git Bash / MSYS
    if [ -x "$here/../../TechPartner Office.exe" ]; then app="$here/../../TechPartner Office.exe"; else app="$here/../../genoffice"; fi
    ;;
  *) app="" ;;
esac

if [ -n "$app" ] && [ -x "$app" ]; then
  ELECTRON_RUN_AS_NODE=1 exec "$app" "$here/techpartner.cjs" "$@"
fi

if [ -f "$here/techpartner.cjs" ]; then
  exec node "$here/techpartner.cjs" "$@"
fi
exec node "$here/../dist/techpartner.cjs" "$@"
